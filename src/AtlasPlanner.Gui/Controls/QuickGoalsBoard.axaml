<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AtlasPlanner.Gui.ViewModels"
             x:Class="AtlasPlanner.Gui.Controls.QuickGoalsBoard"
             x:DataType="vm:MainViewModel">

  <DockPanel ToolTip.Tip="Drag a mechanic into Block or Chase. Drag back to the tray to clear.">

    <!-- Pool of unassigned mechanics -->
    <Border x:Name="TrayDrop" DockPanel.Dock="Top" Classes="quick-tray"
            DragDrop.AllowDrop="True" Margin="0,0,0,8" MaxHeight="150">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Mechanics" Classes="quick-column-title"
                   Margin="0,0,0,4" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding QuickTray}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WeightRow">
                <Border Classes="quick-pill" Tag="{Binding}" Margin="0,0,6,6">
                  <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Block | Chase -->
    <Grid ColumnDefinitions="*,6,*" MinHeight="120">
      <Border x:Name="BlockDrop" Grid.Column="0" Classes="quick-column quick-column-block"
              DragDrop.AllowDrop="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Block" Classes="quick-column-title"
                     Foreground="{StaticResource NegativeBrush}" HorizontalAlignment="Center" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        AllowAutoHide="False" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding QuickBlock}" Margin="0,0,4,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WeightRow">
                  <Border Classes="quick-pill quick-pill-block" Tag="{Binding}" Margin="0,0,6,6">
                    <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border x:Name="ChaseDrop" Grid.Column="2" Classes="quick-column quick-column-chase"
              DragDrop.AllowDrop="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Chase" Classes="quick-column-title"
                     Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        AllowAutoHide="False" Margin="0,4,0,0">
            <ItemsControl ItemsSource="{Binding QuickChase}" Margin="0,0,4,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WeightRow">
                  <Border Classes="quick-pill quick-pill-chase" Tag="{Binding}" Margin="0,0,6,6">
                    <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
