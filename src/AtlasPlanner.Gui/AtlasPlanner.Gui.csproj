<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AtlasPlanner.Gui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    *.Personal.cs (Send to game, etc.) is gitignored and excluded by default so the normal
    solution is the public app. Opt in with: -p:AtlasPlannerPersonal=true
    Publish always sets AtlasPlannerPublic=true, which keeps personal hooks out of the zip.
  -->
  <PropertyGroup Condition="'$(AtlasPlannerPublic)' == 'true'">
    <DefineConstants>$(DefineConstants);ATLASPLANNER_PUBLIC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\*.Personal.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(AtlasPlannerPersonal)' == 'true' And '$(AtlasPlannerPublic)' != 'true'">
    <Compile Include="**\*.Personal.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtlasPlanner.Core\AtlasPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\AtlasTreeData.json" Link="data\AtlasTreeData.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\atlasscores.json" Link="data\atlasscores.json" Condition="Exists('..\..\data\atlasscores.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
