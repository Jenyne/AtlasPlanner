<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AtlasPlanner.Gui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

    <!--
      Public build flag (optional). Personal export UI lives in gitignored *.Personal.cs files;
      publish-public.ps1 excludes those automatically.
      dotnet build -p:AtlasPlannerPublic=true
    -->
    <PropertyGroup Condition="'$(AtlasPlannerPublic)' == 'true'">
      <DefineConstants>$(DefineConstants);ATLASPLANNER_PUBLIC</DefineConstants>
    </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtlasPlanner.Core\AtlasPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\AtlasTreeData.json" Link="data\AtlasTreeData.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\atlasscores.json" Link="data\atlasscores.json" Condition="Exists('..\..\data\atlasscores.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
