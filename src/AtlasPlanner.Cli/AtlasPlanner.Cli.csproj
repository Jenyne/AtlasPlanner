<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>atlasplanner</AssemblyName>
    <RootNamespace>AtlasPlanner.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AtlasPlanner.Core\AtlasPlanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\AtlasTreeData.json" Link="data\AtlasTreeData.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\atlasscores.json" Link="data\atlasscores.json" Condition="Exists('..\..\data\atlasscores.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
